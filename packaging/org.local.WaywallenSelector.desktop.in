[Desktop Entry]
Type=Application
Name=Waywallen Selector
Name[es]=Selector de wallpapers
Comment=Minimal wallpaper carousel for Waywallen
Comment[es]=Carrusel minimalista de fondos animados para Waywallen
Exec="@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_BINDIR@/waywallen-selector"
